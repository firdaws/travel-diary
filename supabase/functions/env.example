# Copy this file to supabase/functions/.env (git-ignored) and fill it in.
# Local:      `supabase functions serve` reads supabase/functions/.env automatically.
# Production: supabase secrets set TRAVEL_BUDDY_API_KEY=your-key
TRAVEL_BUDDY_API_KEY=
# Optional. Defaults to https://visa-requirement.p.rapidapi.com
# TRAVEL_BUDDY_BASE_URL=

# Production: supabase secrets set WEBHOOK_SECRET=<long random string>
WEBHOOK_SECRET=
